# Project Spectra Environment Configuration Example

ENVIRONMENT=development
DEBUG=true

# Security (Generate a secure 64-char key in production: openssl rand -hex 32)
SECRET_KEY=spectra-development-secret-key-replace-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql+asyncpg://spectra:spectra_password@localhost:5432/spectra_db

# Redis (7.2+)
REDIS_URL=redis://localhost:6379/0

# Coturn STUN/TURN Settings
COTURN_STATIC_SECRET=spectra-coturn-shared-hmac-secret-key-32b
COTURN_REALM=turn.spectra.chat
COTURN_HOST=turn.spectra.chat
COTURN_UDP_PORT=3478
COTURN_TLS_PORT=5349
COTURN_CREDENTIAL_TTL_SECONDS=3600

# Registration Policy
INVITE_REQUIRED=true
